{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Pascal Union Numeric Literals",
  "scopeName": "source.pascal-union.numeric",
  "injectionSelector": "L:source.pascal -comment -string -meta.preprocessor",
  "patterns": [
    {
      "name": "constant.numeric.hex.pascal",
      "match": "(?<![A-Za-z0-9_])\\$(?:[0-9A-Fa-f](?:_?[0-9A-Fa-f])*)(?![A-Za-z0-9_])"
    },
    {
      "name": "constant.numeric.binary.pascal",
      "match": "(?<![A-Za-z0-9_])%(?:[01](?:_?[01])*)(?![A-Za-z0-9_])"
    },
    {
      "name": "constant.numeric.octal.pascal",
      "match": "(?<![A-Za-z0-9_])&(?:[0-7](?:_?[0-7])*)(?![A-Za-z0-9_])"
    },
    {
      "name": "constant.numeric.float.pascal",
      "match": "(?<![A-Za-z0-9_$%&])(?:[0-9](?:_?[0-9])*)(?:\\.(?:[0-9](?:_?[0-9])*))?[eE][+-]?(?:[0-9](?:_?[0-9])*)(?![A-Za-z0-9_])"
    },
    {
      "name": "constant.numeric.float.pascal",
      "match": "(?<![A-Za-z0-9_$%&])(?:[0-9](?:_?[0-9])*)\\.(?:[0-9](?:_?[0-9])*)(?![A-Za-z0-9_])"
    },
    {
      "name": "constant.numeric.integer.pascal",
      "match": "(?<![A-Za-z0-9_$%&])(?:[0-9](?:_?[0-9])*)(?![A-Za-z0-9_])"
    }
  ]
}
