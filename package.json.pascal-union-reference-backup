{
	"name": "pascal-union",
	"displayName": "Pascal Union",
	"description": "%pascalUnion.description%",
	"version": "0.8.109",
	"publisher": "BoringLi",
	"author": "BORING",
	"license": "MIT",
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Programming Languages",
		"Other"
	],
	"keywords": [
		"delphi",
		"pascal",
		"object-pascal",
		"rad-studio",
		"groupproj",
		"formatter",
		"debugger",
		"vallenta",
		"lsp"
	],
	"main": "./src/extension.js",
	"extensionPack": [
		"VallentaStudio.vallenta-studio",
		"ms-vscode.cpptools"
	],
	"activationEvents": [
		"*"
	],
	"contributes": {
		"debuggers": [
			{
				"type": "pascal-union-run",
				"label": "Pascal Union Run",
				"languages": [
					"pascal",
					"objectpascal"
				]
			}
		],
		"languages": [
			{
				"id": "pascal-union-dproj",
				"aliases": [
					"Delphi Project",
					"DPROJ"
				],
				"configuration": "./resources/delphi-project.language-configuration.json"
			},
			{
				"id": "pascal-union-platform",
				"aliases": [
					"Delphi Platform Source"
				]
			}
		],
		"grammars": [
			{
				"language": "pascal-union-dproj",
				"scopeName": "text.xml.pascal-union-dproj",
				"path": "./resources/delphi-project.tmLanguage.json"
			},
			{
				"language": "pascal-union-platform",
				"scopeName": "source.pascal-union-platform",
				"path": "./resources/pascal-platform.tmLanguage.json"
			},
			{
				"scopeName": "source.pascal-union.numeric",
				"path": "./resources/pascal-numeric.injection.tmLanguage.json",
				"injectTo": [
					"source.pascal",
					"source.pascal-union-platform"
				]
			}
		],
		"snippets": [
			{
				"language": "pascal",
				"path": "./resources/pascal.code-snippets.json"
			},
			{
				"language": "objectpascal",
				"path": "./resources/pascal.code-snippets.json"
			},
			{
				"language": "pascal",
				"path": "./resources/pascal-keywords.code-snippets.json"
			},
			{
				"language": "objectpascal",
				"path": "./resources/pascal-keywords.code-snippets.json"
			}
		],
		"commands": [
			{
				"command": "pascalUnion.projectNavigator.refresh",
				"title": "Pascal Union：刷新 Delphi 工程树",
				"icon": "$(refresh)"
			},
			{
				"command": "pascalUnion.projectNavigator.actions",
				"title": "Pascal Union：工程组操作",
				"icon": "$(tools)"
			},
			{
				"command": "pascalUnion.build.compilePackage",
				"title": "Compile",
				"icon": "$(play)"
			},
			{
				"command": "pascalUnion.build.buildPackage",
				"title": "Build",
				"icon": "$(tools)"
			},
			{
				"command": "pascalUnion.build.cleanPackage",
				"title": "Clean",
				"icon": "$(trash)"
			},
			{
				"command": "pascalUnion.debug.debugPackage",
				"title": "Debug",
				"icon": "$(debug-alt)",
				"enablement": "!pascalUnion.executionBusy"
			},
			{
				"command": "pascalUnion.debug.attachPackage",
				"title": "Attach",
				"icon": "$(plug)",
				"enablement": "!pascalUnion.executionBusy"
			},
			{
				"command": "pascalUnion.build.compileGroup",
				"title": "Compile All",
				"icon": "$(run-all)"
			},
			{
				"command": "pascalUnion.build.buildGroup",
				"title": "Build All",
				"icon": "$(tools)"
			},
			{
				"command": "pascalUnion.build.cleanGroup",
				"title": "Clean All",
				"icon": "$(trash)"
			},
			{
				"command": "pascalUnion.debug.buildAndDebugGroup",
				"title": "Debug",
				"icon": "$(debug-start)",
				"enablement": "!pascalUnion.executionBusy"
			},
			{
				"command": "pascalUnion.run.group",
				"title": "Run",
				"icon": "$(run)",
				"enablement": "!pascalUnion.executionBusy"
			},
			{
				"command": "pascalUnion.run.stop",
				"title": "Stop Run",
				"icon": "$(debug-stop)",
				"enablement": "pascalUnion.runInProgress"
			},
			{
				"command": "pascalUnion.debug.selectStartupProject",
				"title": "Select Startup Project"
			},
			{
				"command": "pascalUnion.build.selectConfiguration",
				"title": "Select Build Configuration"
			},
			{
				"command": "pascalUnion.build.selectPlatform",
				"title": "Select Build Platform"
			},
			{
				"command": "pascalUnion.classNavigator.context.buildPackage",
				"title": "构建包"
			},
			{
				"command": "pascalUnion.classNavigator.context.compilePackage",
				"title": "编译包"
			},
			{
				"command": "pascalUnion.classNavigator.context.cleanPackage",
				"title": "清理包"
			},
			{
				"command": "pascalUnion.classNavigator.context.debugPackage",
				"title": "调试包",
				"enablement": "!pascalUnion.executionBusy"
			},
			{
				"command": "pascalUnion.classNavigator.context.attachPackage",
				"title": "附加到包宿主",
				"enablement": "!pascalUnion.executionBusy"
			},
			{
				"command": "pascalUnion.classNavigator.context.buildGroup",
				"title": "构建全部"
			},
			{
				"command": "pascalUnion.classNavigator.context.compileGroup",
				"title": "编译全部"
			},
			{
				"command": "pascalUnion.classNavigator.context.cleanGroup",
				"title": "清理全部"
			},
			{
				"command": "pascalUnion.classNavigator.context.runGroup",
				"title": "运行启动工程",
				"enablement": "!pascalUnion.executionBusy"
			},
			{
				"command": "pascalUnion.classNavigator.context.debugGroup",
				"title": "构建并调试",
				"enablement": "!pascalUnion.executionBusy"
			},
			{
				"command": "pascalUnion.classNavigator.context.selectStartupProject",
				"title": "选择启动工程"
			},
			{
				"command": "pascalUnion.classNavigator.context.selectConfiguration",
				"title": "选择构建配置"
			},
			{
				"command": "pascalUnion.classNavigator.context.selectPlatform",
				"title": "选择平台"
			},
			{
				"command": "pascalUnion.build.selectOutputFilters",
				"title": "Pascal Union：勾选构建输出",
				"icon": "$(filter)"
			},
			{
				"command": "pascalUnion.build.toggleErrors",
				"title": "显示错误",
				"icon": "$(error)"
			},
			{
				"command": "pascalUnion.build.toggleWarnings",
				"title": "显示警告",
				"icon": "$(warning)"
			},
			{
				"command": "pascalUnion.build.toggleOther",
				"title": "显示其他信息",
				"icon": "$(info)"
			},
			{
				"command": "pascalUnion.build.toggleErrorsChecked",
				"title": "✓ 显示错误",
				"icon": {
					"light": "media/build-filter-error-checked-light.svg",
					"dark": "media/build-filter-error-checked-dark.svg"
				}
			},
			{
				"command": "pascalUnion.build.toggleWarningsChecked",
				"title": "✓ 显示警告",
				"icon": {
					"light": "media/build-filter-warning-checked-light.svg",
					"dark": "media/build-filter-warning-checked-dark.svg"
				}
			},
			{
				"command": "pascalUnion.build.toggleOtherChecked",
				"title": "✓ 显示其他信息",
				"icon": {
					"light": "media/build-filter-info-checked-light.svg",
					"dark": "media/build-filter-info-checked-dark.svg"
				}
			},
			{
				"command": "pascalUnion.dependencies.check",
				"title": "Pascal Union：检查并安装必要扩展"
			},
			{
				"command": "pascalUnion.openSettings",
				"title": "Pascal Union：打开分页设置",
				"icon": "$(settings-gear)"
			},
			{
				"command": "pascalUnion.openNativeSettings",
				"title": "Pascal Union：打开 VS Code 设置"
			},
			{
				"command": "pascalUnion.controlCenter.refresh",
				"title": "Pascal Union：刷新控制中心",
				"icon": "$(refresh)"
			},
			{
				"command": "pascalUnion.classNavigator.refresh",
				"title": "Pascal Union：刷新 Delphi 类导航",
				"icon": "$(refresh)"
			},
			{
				"command": "pascalUnion.classNavigator.selectSort",
				"title": "Pascal Union：选择 Delphi 导航排序",
				"icon": "$(sort-precedence)"
			},
			{
				"command": "pascalUnion.classNavigator.find",
				"title": "Pascal Union：查找 Delphi 导航条目",
				"icon": "$(search)"
			},
			{
				"command": "pascalUnion.classNavigator.generateAiSteps",
				"title": "生成 AI 步骤",
				"icon": "$(sparkle)"
			},
			{
				"command": "pascalUnion.classNavigator.generateDetailedAiSteps",
				"title": "详细生成 AI 步骤",
				"icon": "$(list-tree)"
			},
			{
				"command": "pascalUnion.classNavigator.stopAiGeneration",
				"title": "Pascal Union：停止 AI 步骤生成",
				"icon": "$(debug-stop)"
			},
			{
				"command": "pascalUnion.classNavigator.show",
				"title": "Pascal Union：打开 Delphi 类导航"
			},
			{
				"command": "pascalUnion.navigator.showProjects",
				"title": "Pascal Union：切换到 Delphi 工程",
				"icon": "$(project)"
			},
			{
				"command": "pascalUnion.navigator.showClasses",
				"title": "Pascal Union：切换到类导航",
				"icon": "$(symbol-class)"
			},
			{
				"command": "pascalUnion.navigator.toggleMode",
				"title": "Pascal Union：切换类导航 / Delphi 工程",
				"icon": "$(arrow-swap)"
			},
			{
				"command": "pascalUnion.coloring.colors.reset",
				"title": "Pascal Union：一键恢复默认符号颜色"
			},
			{
				"command": "pascalUnion.formatter.formatDocument",
				"title": "Pascal Union：格式化当前 Pascal 文件"
			},
			{
				"command": "pascalUnion.formatter.style.save",
				"title": "Pascal Union：保存自定义格式化规范"
			},
			{
				"command": "pascalUnion.formatter.style.load",
				"title": "Pascal Union：加载自定义格式化规范"
			},
			{
				"command": "pascalUnion.sync",
				"title": "Pascal Union：同步全部已加载工程"
			},
			{
				"command": "pascalUnion.projects.detect",
				"title": "Pascal Union：识别并加载工作区 Project Group"
			},
			{
				"command": "pascalUnion.restore",
				"title": "Pascal Union：移除托管路径"
			},
			{
				"command": "pascalUnion.showPaths",
				"title": "Pascal Union：显示托管路径"
			},
			{
				"command": "pascalUnion.goToDefinition",
				"title": "Pascal Union：跳转到最佳定义或实现"
			},
			{
				"command": "pascalUnion.peekAllDefinitions",
				"title": "Pascal Union：选择全部定义和实现"
			},
			{
				"command": "pascalUnion.addUnit",
				"title": "Pascal Union：将 Unit 加入 uses"
			},
			{
				"command": "pascalUnion.diagnostics.runNow",
				"title": "Pascal Union：立即运行后台诊断"
			},
			{
				"command": "pascalUnion.diagnostics.clear",
				"title": "Pascal Union：清除后台诊断"
			},
			{
				"command": "pascalUnion.diagnostics.clearCache",
				"title": "Pascal Union：清除编译器缓存"
			},
			{
				"command": "pascalUnion.diagnostics.showStatus",
				"title": "Pascal Union：显示诊断状态"
			},
			{
				"command": "pascalUnion.completion.typeSpace",
				"title": "Pascal Union：输入空格或展开控制语句"
			}
		],
		"keybindings": [
			{
				"command": "pascalUnion.classNavigator.find",
				"key": "ctrl+alt+n",
				"when": "!inQuickOpen && ((editorLangId =~ /^(pascal|objectpascal)$/ && resourceScheme == file) || focusedView == pascalUnion.classNavigator || pascalUnion.classNavigator.webviewFocused) && config.pascalUnion.enabled && config.pascalUnion.classNavigator.enabled"
			},
			{
				"command": "pascalUnion.completion.typeSpace",
				"key": "space",
				"when": "editorTextFocus && !editorReadonly && editorLangId =~ /^(pascal|objectpascal)$/ && config.pascalUnion.enabled && config.pascalUnion.completion.enabled"
			},
			{
				"command": "pascalUnion.formatter.formatDocument",
				"key": "shift+alt+f",
				"when": "editorTextFocus && editorLangId =~ /^(pascal|objectpascal)$/ && config.pascalUnion.formatter.shortcut == shiftAltF"
			},
			{
				"command": "pascalUnion.formatter.formatDocument",
				"key": "ctrl+alt+f",
				"when": "editorTextFocus && editorLangId =~ /^(pascal|objectpascal)$/ && config.pascalUnion.formatter.shortcut == ctrlAltF"
			},
			{
				"command": "pascalUnion.formatter.formatDocument",
				"key": "ctrl+k ctrl+f",
				"when": "editorTextFocus && editorLangId =~ /^(pascal|objectpascal)$/ && config.pascalUnion.formatter.shortcut == ctrlKCtrlF"
			},
			{
				"command": "pascalUnion.goToDefinition",
				"key": "f12",
				"when": "editorTextFocus && editorLangId == pascal && resourceScheme == file"
			},
			{
				"command": "pascalUnion.peekAllDefinitions",
				"key": "alt+f12",
				"when": "editorTextFocus && editorLangId == pascal && resourceScheme == file && config.pascalUnion.navigation.candidatePickerShortcut == altF12"
			},
			{
				"command": "pascalUnion.peekAllDefinitions",
				"key": "ctrl+alt+f12",
				"when": "editorTextFocus && editorLangId == pascal && resourceScheme == file && config.pascalUnion.navigation.candidatePickerShortcut == ctrlAltF12"
			},
			{
				"command": "pascalUnion.debug.buildAndDebugGroup",
				"key": "f5",
				"when": "pascalUnion.hasProjectGroups && !inDebugMode && !pascalUnion.executionBusy && config.pascalUnion.debugger.enabled && config.pascalUnion.debugger.shortcutMode == visualStudio"
			},
			{
				"command": "pascalUnion.run.group",
				"key": "ctrl+f5",
				"when": "pascalUnion.hasProjectGroups && !inDebugMode && !pascalUnion.executionBusy && config.pascalUnion.debugger.shortcutMode == visualStudio"
			},
			{
				"command": "pascalUnion.run.stop",
				"key": "shift+f5",
				"when": "pascalUnion.runInProgress && config.pascalUnion.debugger.shortcutMode == visualStudio"
			},
			{
				"command": "pascalUnion.debug.buildAndDebugGroup",
				"key": "f9",
				"when": "pascalUnion.hasProjectGroups && !inDebugMode && !pascalUnion.executionBusy && config.pascalUnion.debugger.enabled && config.pascalUnion.debugger.shortcutMode == radStudio"
			},
			{
				"command": "pascalUnion.run.group",
				"key": "ctrl+shift+f9",
				"when": "pascalUnion.hasProjectGroups && !inDebugMode && !pascalUnion.executionBusy && config.pascalUnion.debugger.shortcutMode == radStudio"
			},
			{
				"command": "workbench.action.debug.stop",
				"key": "ctrl+f2",
				"when": "inDebugMode && config.pascalUnion.debugger.shortcutMode == radStudio"
			},
			{
				"command": "workbench.action.debug.stepOver",
				"key": "f8",
				"when": "inDebugMode && config.pascalUnion.debugger.shortcutMode == radStudio"
			},
			{
				"command": "workbench.action.debug.stepInto",
				"key": "f7",
				"when": "inDebugMode && config.pascalUnion.debugger.shortcutMode == radStudio"
			},
			{
				"command": "workbench.action.debug.stepOut",
				"key": "shift+f8",
				"when": "inDebugMode && config.pascalUnion.debugger.shortcutMode == radStudio"
			},
			{
				"command": "editor.debug.action.toggleBreakpoint",
				"key": "f5",
				"when": "editorTextFocus && config.pascalUnion.debugger.shortcutMode == radStudio"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "pascalUnion",
					"title": "Pascal Union",
					"icon": "media/pascal-union.svg"
				}
			]
		},
		"views": {
			"pascalUnion": [
				{
					"id": "pascalUnion.controlCenter",
					"name": "能力与设置",
					"type": "webview"
				}
			],
			"explorer": [
				{
					"id": "pascalUnion.classNavigator",
					"name": "Delphi 导航",
					"type": "webview",
					"when": "config.pascalUnion.enabled && (config.pascalUnion.classNavigator.enabled || config.pascalUnion.projectNavigator.enabled)",
					"visibility": "visible"
				}
			]
		},
		"menus": {
			"terminal/context": [
				{
					"command": "pascalUnion.build.toggleErrors",
					"when": "config.pascalUnion.build.enabled && !config.pascalUnion.build.output.showErrors",
					"group": "1_pascalUnion@1"
				},
				{
					"command": "pascalUnion.build.toggleErrorsChecked",
					"when": "config.pascalUnion.build.enabled && config.pascalUnion.build.output.showErrors",
					"group": "1_pascalUnion@1"
				},
				{
					"command": "pascalUnion.build.toggleWarnings",
					"when": "config.pascalUnion.build.enabled && !config.pascalUnion.build.output.showWarnings",
					"group": "1_pascalUnion@2"
				},
				{
					"command": "pascalUnion.build.toggleWarningsChecked",
					"when": "config.pascalUnion.build.enabled && config.pascalUnion.build.output.showWarnings",
					"group": "1_pascalUnion@2"
				},
				{
					"command": "pascalUnion.build.toggleOther",
					"when": "config.pascalUnion.build.enabled && !config.pascalUnion.build.output.showOther",
					"group": "1_pascalUnion@3"
				},
				{
					"command": "pascalUnion.build.toggleOtherChecked",
					"when": "config.pascalUnion.build.enabled && config.pascalUnion.build.output.showOther",
					"group": "1_pascalUnion@3"
				}
			],
			"terminal/title/context": [
				{
					"command": "pascalUnion.build.toggleErrors",
					"when": "config.pascalUnion.build.enabled && !config.pascalUnion.build.output.showErrors",
					"group": "1_pascalUnion@1"
				},
				{
					"command": "pascalUnion.build.toggleErrorsChecked",
					"when": "config.pascalUnion.build.enabled && config.pascalUnion.build.output.showErrors",
					"group": "1_pascalUnion@1"
				},
				{
					"command": "pascalUnion.build.toggleWarnings",
					"when": "config.pascalUnion.build.enabled && !config.pascalUnion.build.output.showWarnings",
					"group": "1_pascalUnion@2"
				},
				{
					"command": "pascalUnion.build.toggleWarningsChecked",
					"when": "config.pascalUnion.build.enabled && config.pascalUnion.build.output.showWarnings",
					"group": "1_pascalUnion@2"
				},
				{
					"command": "pascalUnion.build.toggleOther",
					"when": "config.pascalUnion.build.enabled && !config.pascalUnion.build.output.showOther",
					"group": "1_pascalUnion@3"
				},
				{
					"command": "pascalUnion.build.toggleOtherChecked",
					"when": "config.pascalUnion.build.enabled && config.pascalUnion.build.output.showOther",
					"group": "1_pascalUnion@3"
				}
			],
			"commandPalette": [
				{
					"command": "pascalUnion.build.toggleErrorsChecked",
					"when": "false"
				},
				{
					"command": "pascalUnion.build.toggleWarningsChecked",
					"when": "false"
				},
				{
					"command": "pascalUnion.build.toggleOtherChecked",
					"when": "false"
				},
				{
					"command": "pascalUnion.classNavigator.context.buildPackage",
					"when": "false"
				},
				{
					"command": "pascalUnion.classNavigator.context.compilePackage",
					"when": "false"
				},
				{
					"command": "pascalUnion.classNavigator.context.cleanPackage",
					"when": "false"
				},
				{
					"command": "pascalUnion.classNavigator.context.debugPackage",
					"when": "false"
				},
				{
					"command": "pascalUnion.classNavigator.context.attachPackage",
					"when": "false"
				},
				{
					"command": "pascalUnion.classNavigator.context.buildGroup",
					"when": "false"
				},
				{
					"command": "pascalUnion.classNavigator.context.compileGroup",
					"when": "false"
				},
				{
					"command": "pascalUnion.classNavigator.context.cleanGroup",
					"when": "false"
				},
				{
					"command": "pascalUnion.classNavigator.context.runGroup",
					"when": "false"
				},
				{
					"command": "pascalUnion.classNavigator.context.debugGroup",
					"when": "false"
				},
				{
					"command": "pascalUnion.classNavigator.context.selectStartupProject",
					"when": "false"
				},
				{
					"command": "pascalUnion.classNavigator.context.selectConfiguration",
					"when": "false"
				},
				{
					"command": "pascalUnion.classNavigator.context.selectPlatform",
					"when": "false"
				}
			],
			"view/item/context": [
				{
