{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noEmitOnError": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "inlineSources": true,
    "rootDir": ".",
    "outDir": "out",
    "types": [
      "node",
      "vscode"
    ],
    "skipLibCheck": true,
    "lib": [
      "ES2023"
    ]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "src/webview"
  ]
}
